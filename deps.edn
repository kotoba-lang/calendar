{:paths ["src" "resources"]
 :deps {}
 :aliases
 {:test {:extra-paths ["test"]
         ;; The compiler is TEST-ONLY, for `overlaps-parity-test`: it compiles
         ;; `src/calendar/model.kotoba` and runs it against the `.cljc` over the
         ;; same inputs. Nothing in `src/` requires it, so this cannot change
         ;; what the library does -- same split the :kotoba alias already had,
         ;; which only ever ran the CLI from CI.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/compiler.git"
                       ;; Same pin the :kotoba alias uses, so the gate measures
                       ;; the compiler this repo actually ships against.
                       :git/sha "bef32b78852212bc096849d1ff9779c8afae4796"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :kotoba {:extra-deps {io.github.kotoba-lang/compiler
                        {:git/url "https://github.com/kotoba-lang/compiler.git"
                         :git/sha "bef32b78852212bc096849d1ff9779c8afae4796"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
